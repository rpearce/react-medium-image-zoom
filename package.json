  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp ./src/styles.css ./dist/styles.css && pnpm run check:ssr",
    "build:docs": "rm -rf ./docs && mkdir ./docs && pnpm run storybook:build",
    "changeset": "changeset",
    "check:all": "conc 'pnpm:check:js' 'pnpm:check:types' 'pnpm:check:fmt'",
    "check:all:fix": "pnpm run check:js:fix && pnpm run check:fmt:fix && pnpm run check:types",
    "check:fmt": "oxfmt --check",
    "check:fmt:fix": "oxfmt",
    "check:ssr": "node scripts/check-ssr",
    "check:js": "oxlint",
    "check:js:fix": "oxlint --fix",
    "check:types": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "ci": "conc 'pnpm:check:all' 'pnpm:test' 'pnpm:build' 'pnpm:build:docs'",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate",
    "prebuild": "rm -rf ./dist",
    "prepack": "conc 'pnpm:check:js' 'pnpm:build'",
    "prerelease": "pnpm run ci",
    "release": "changeset publish",
    "start": "pnpm run storybook:dev",
    "storybook:build": "storybook build --quiet -o docs",
    "storybook:dev": "storybook dev -p 6006"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
